{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "**",      "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      "src",
      "public",
      "android",
      "dist",
      "*.md",
      "render.yaml",
      "vercel.json",
      "Procfile",
      "capacitor.config.json",
      "vite.config.js",
      ".firebaserc",
      "logo",
      "TET-ERP-Blueprint-2026.docx",
      "generate-blueprint.cjs",
      "invoices_temp.json"
    ]
  }
}
